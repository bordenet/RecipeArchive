# ------------------------------------------------------------------------------
# AWS Authentication
# - Used by AWS CLI and CDK for deployment.
# - It is recommended to use `aws configure` instead of setting them here.
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# AWS S3 - Web App Hosting
# - S3 bucket and CloudFront distribution for the Flutter web app.
# - WEB_APP_URL: Full CloudFront URL (used by extensions to link to web app)
# - Format: https://{CLOUDFRONT_DISTRIBUTION_ID}.cloudfront.net
# ------------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=your-account-id-here
S3_WEB_APP_BUCKET=your-s3-bucket-name
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id
CLOUDFRONT_URL=https://your-cloudfront-distribution-id.cloudfront.net
WEB_APP_URL=https://your-cloudfront-distribution-id.cloudfront.net

# ------------------------------------------------------------------------------
# AWS API Gateway & Lambda
# - API Gateway and Lambda function configuration.
# - API_BASE_URL: Full URL to your API Gateway endpoint (used by extensions/apps)
# - Format: https://{API_GATEWAY_ID}.execute-api.{AWS_REGION}.amazonaws.com/{API_STAGE}
# ------------------------------------------------------------------------------
API_GATEWAY_ID=your-api-gateway-id
API_GATEWAY_NAME=recipeArchive-api
API_STAGE=prod
API_BASE_URL=https://your-api-gateway-id.execute-api.us-west-2.amazonaws.com/prod

# ------------------------------------------------------------------------------
# AWS Cognito - User Authentication
# - COGNITO_USER_POOL_ID: Found in AWS Cognito Console (e.g., us-west-2_XXXXXXXXX)
# - COGNITO_APP_CLIENT_ID: Found under App Clients in your User Pool
# - These IDs are used by web extensions and mobile apps for authentication
# ------------------------------------------------------------------------------
COGNITO_USER_POOL_NAME=recipeArchive-users
COGNITO_APP_CLIENT_NAME=recipeArchive-client
COGNITO_USER_POOL_ID=your-user-pool-id-here
COGNITO_APP_CLIENT_ID=your-app-client-id-here

# ------------------------------------------------------------------------------
# AWS DynamoDB - Recipe Storage
# ------------------------------------------------------------------------------
DYNAMODB_TABLE_NAME=recipeArchive-recipes
DYNAMODB_BILLING_MODE=ON_DEMAND

# ------------------------------------------------------------------------------
# AWS S3 - Asset Storage
# - S3 buckets for storing recipe assets, temp files, and failed parsing attempts.
# - S3_STORAGE_BUCKET: Primary alias for recipe storage (same as S3_RECIPE_STORAGE_BUCKET)
# - S3_TEMP_BUCKET_NAME: Temporary storage for in-flight recipe processing
# - S3_FAILED_PARSING_BUCKET_NAME: Storage for recipes that failed to parse
# ------------------------------------------------------------------------------
S3_RECIPE_STORAGE_BUCKET=recipearchive-storage-${AWS_ACCOUNT_ID}
S3_STORAGE_BUCKET=recipearchive-storage-${AWS_ACCOUNT_ID}
S3_TEMP_BUCKET_NAME=recipearchive-temp-${AWS_ACCOUNT_ID}
S3_FAILED_PARSING_BUCKET_NAME=recipearchive-failed-${AWS_ACCOUNT_ID}
S3_REGION=us-west-2

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=prod
PROJECT_NAME=recipeArchive
ADMIN_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# Testing - E2E & Validation
# - Credentials for `validate-monorepo.sh` script.
# ------------------------------------------------------------------------------
RECIPE_USER_EMAIL=
RECIPE_USER_PASSWORD=
RECIPE_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# AI Mock Testing (Development Only)
# - Enables AI-controlled mocking of OpenAI API for testing
# - ONLY works in VS Code with mock-controller server running
# - NEVER set to true in production
# - See docs/testing/ai-mock-testing.md for details
# ------------------------------------------------------------------------------
AI_MOCK_TESTING=false