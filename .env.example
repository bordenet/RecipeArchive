# ------------------------------------------------------------------------------
# AWS Credentials - REQUIRED
# ------------------------------------------------------------------------------
# These are your personal AWS credentials. They are used by the AWS CLI and CDK
# to deploy and manage your AWS resources.
#
# How to get them:
# 1. Create an IAM user in the AWS console.
# 2. Grant the user the required permissions (see docs/setup/aws-setup.md).
# 3. Create an access key for the user.
# 4. Run `aws configure` and enter the access key ID and secret access key.
#
# The script will use the credentials configured in your environment.
# You can also set them here, but it's not recommended for security reasons.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# AWS Infrastructure - REQUIRED
# ------------------------------------------------------------------------------
# These variables define the names and IDs of the AWS resources that will be
# created and used by the application.
#
# How to get them:
# These resources are created by the AWS CDK. After you run `cdk deploy` from
# the `aws-backend/infrastructure` directory, the output will contain the
# values for these variables.

# The AWS region where the resources will be deployed.
AWS_REGION=us-west-2

# The ID of your AWS account.
AWS_ACCOUNT_ID=your-account-id-here

# The name of the S3 bucket where the Flutter web app will be deployed.
S3_BUCKET=your-s3-bucket-name

# The ID of the CloudFront distribution for the web app.
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# The URL of the CloudFront distribution.
CLOUDFRONT_URL=https://your-cloudfront-url.com

# The ID of the API Gateway.
API_GATEWAY_ID=your-api-gateway-id

# The name of the Cognito User Pool.
COGNITO_USER_POOL_NAME=recipeArchive-users

# The name of the Cognito App Client.
COGNITO_APP_CLIENT_NAME=recipeArchive-client

# The email address of the admin user.
ADMIN_EMAIL=your-email@example.com

# The name of the DynamoDB table.
DYNAMODB_TABLE_NAME=recipeArchive-recipes

# The billing mode for the DynamoDB table.
DYNAMODB_BILLING_MODE=ON_DEMAND

# The name of the S3 bucket for storing recipe assets.
S3_BUCKET_NAME=recipearchive-storage-${AWS_ACCOUNT_ID}

# The region of the S3 bucket.
S3_REGION=us-west-2

# The name of the API Gateway.
API_GATEWAY_NAME=recipeArchive-api

# The stage of the API Gateway.
API_STAGE=prod

# The environment (e.g., prod, dev).
ENVIRONMENT=prod

# The name of the project.
PROJECT_NAME=recipeArchive

# ------------------------------------------------------------------------------
# Testing Credentials - OPTIONAL
# ------------------------------------------------------------------------------
# These credentials are used for running certain tests in the
# `validate-monorepo.sh` script.

# The email address of a test user.
RECIPE_USER_EMAIL=

# The password of a test user.
RECIPE_USER_PASSWORD=

# The admin token for running multi-tenant invitation flow tests.
RECIPE_ADMIN_TOKEN=
