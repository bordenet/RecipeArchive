# ------------------------------------------------------------------------------
# AWS Authentication
# - Used by AWS CLI and CDK for deployment.
# - It is recommended to use `aws configure` instead of setting them here.
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# AWS S3 - Web App Hosting
# - S3 bucket and CloudFront distribution for the Flutter web app.
# ------------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=your-account-id-here
S3_WEB_APP_BUCKET=your-s3-bucket-name
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id
CLOUDFRONT_URL=https://your-cloudfront-url.com

# ------------------------------------------------------------------------------
# AWS API Gateway & Lambda
# - API Gateway and Lambda function configuration.
# ------------------------------------------------------------------------------
API_GATEWAY_ID=your-api-gateway-id
API_GATEWAY_NAME=recipeArchive-api
API_STAGE=prod

# ------------------------------------------------------------------------------
# AWS Cognito - User Authentication
# ------------------------------------------------------------------------------
COGNITO_USER_POOL_NAME=recipeArchive-users
COGNITO_APP_CLIENT_NAME=recipeArchive-client

# ------------------------------------------------------------------------------
# AWS DynamoDB - Recipe Storage
# ------------------------------------------------------------------------------
DYNAMODB_TABLE_NAME=recipeArchive-recipes
DYNAMODB_BILLING_MODE=ON_DEMAND

# ------------------------------------------------------------------------------
# AWS S3 - Asset Storage
# - S3 bucket for storing recipe assets and browser extensions.
# ------------------------------------------------------------------------------
S3_RECIPE_STORAGE_BUCKET=recipearchive-storage-${AWS_ACCOUNT_ID}
S3_REGION=us-west-2

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=prod
PROJECT_NAME=recipeArchive
ADMIN_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# Testing - E2E & Validation
# - Credentials for `validate-monorepo.sh` script.
# ------------------------------------------------------------------------------
RECIPE_USER_EMAIL=
RECIPE_USER_PASSWORD=
RECIPE_ADMIN_TOKEN=