# .gitignore for RecipeArchive Monorepo

# =============================================================================
# SECURITY: Never commit credentials, secrets, or user data
# =============================================================================
.env
.env.local
.env.*.local
.env.production
.env.development
aws-credentials.json
secrets.json
config/secrets.yml
*.pem
*.key
*.p12
*.pfx
gitleaks-report.json

# User data backups (contains PII like emails)
backups/

# Historical archive (outdated snapshots)
archive/

# Generated Flutter env (copied from root .env)
recipe_archive/.env

# Generated browser extension env config
extensions/*/env-config.js

# =============================================================================
# Build artifacts and caches (should never be committed)
# =============================================================================

# Python
.coverage
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
