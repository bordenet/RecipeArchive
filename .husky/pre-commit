#!/bin/bash

# Pre-commit hook to prevent binary files from being committed

echo "🔍 Checking for binary files..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check for known binary patterns
BLOCKED_FILES=""
for file in $STAGED_FILES; do
  # Skip if file doesn't exist (deleted files)
  [ ! -f "$file" ] && continue

  # Check for explicit binary extensions
  if echo "$file" | grep -qE '\.(exe|dll|so|dylib|a|o|bin)$'; then
    echo "❌ BLOCKED: Binary extension: $file"
    BLOCKED_FILES="$BLOCKED_FILES\n  - $file"
    continue
  fi

  # Check for tool binaries without extensions (like content-ops, recipe-tracer, get-diagnostics)
  if echo "$file" | grep -qE '^tools/[^/]+/[^/]+$' && [ -x "$file" ]; then
    # Use 'file' command to check if it's a binary
    if file "$file" | grep -qE "(Mach-O|ELF|PE32|executable)"; then
      echo "❌ BLOCKED: Tool binary: $file"
      BLOCKED_FILES="$BLOCKED_FILES\n  - $file"
    fi
  fi

  # Check for Lambda bootstrap binaries
  if echo "$file" | grep -qE '^aws-backend/functions/.*/bootstrap$'; then
    echo "❌ BLOCKED: Lambda bootstrap: $file"
    BLOCKED_FILES="$BLOCKED_FILES\n  - $file"
  fi

  # Check for deployment packages
  if echo "$file" | grep -qE '\.(zip|tar\.gz)$'; then
    echo "❌ BLOCKED: Archive file: $file"
    BLOCKED_FILES="$BLOCKED_FILES\n  - $file"
  fi
done

if [ -n "$BLOCKED_FILES" ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: Binary/build artifacts detected"
  echo "📋 Blocked files:"
  echo -e "$BLOCKED_FILES"
  echo ""
  echo "💡 Binary files should be built locally and not committed"
  echo "💡 Ensure these files are in .gitignore"
  exit 1
fi

echo "✅ No binary files detected"

# Run tests
npm test
