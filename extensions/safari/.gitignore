# Safari Extension .gitignore

# Dependencies
node_modules/

# Build artifacts
*.zip
dist/
build/
__tests__/

# Configuration files with secrets
config.json
secrets.json
.env*

# Auto-generated files (created at build time from .env)
env-config.js
manifest.json

# Operating system files
.DS_Store
Thumbs.db

# Development backup files
*-backup.*
*-old.*
*-original.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
