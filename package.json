{
  "name": "recipe-archive-monorepo",
  "version": "1.0.0",
  "description": "Cross-device recipe archiving platform with browser extensions, AWS backend, and native apps",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:parsers": "jest --config=config/jest.config.js --testMatch='**/parsers/tests/**/*.test.ts'",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:integration": "jest --testMatch='**/tests/integration/**/*.test.js' --testTimeout=20000",
    "test:coverage": "jest --config=config/jest.config.js --coverage --testMatch='**/tests/unit/**/*.test.js' --testMatch='**/parsers/tests/**/*.test.ts' --testMatch='**/extensions/shared/tests/**/*.test.js'",
    "test:coverage:all": "jest --coverage --testMatch='**/tests/**/*.test.js'",
    "test:go": "bash scripts/test-go-coverage.sh",
    "test:go:coverage": "bash scripts/test-go-coverage.sh",
    "test:go:html": "bash scripts/test-go-coverage.sh --html",
    "test:multi-tenant": "cd tests/multi-tenant && ./run-tests.sh",
    "test:tenant-isolation": "cd tests/multi-tenant && go test -v ./...",
    "test:invitation-flow": "cd tests/multi-tenant && npm test",
    "test:e2e": "jest --testMatch='**/tests/e2e/**/*.test.js' --testTimeout=90000",
    "test:e2e:site": "jest --testMatch='**/tests/e2e/**/*.test.js' --testTimeout=90000",
    "test:extensions": "node tests/automation/extension-regression-test.js",
    "test:build-validation": "node tests/automation/build-validation-pipeline.js",
    "test:no-human": "npm run test:extensions && npm run test:build-validation",
    "dev:start": "cd tools && ./bin/recipe-cli dev start",
    "dev:stop": "cd tools && ./bin/recipe-cli dev stop",
    "validate": "cd tools && ./bin/recipe-cli validate env",
    "deploy": "cd tools && ./bin/recipe-cli deploy aws",
    "deploy:staging": "cd tools && ./bin/recipe-cli deploy aws staging",
    "deploy:prod": "cd tools && ./bin/recipe-cli deploy aws prod",
    "ts-check": "tsc --noEmit",
    "build:parser-bundle": "node tools/build-parser-bundle.cjs",
    "build:extension-env": "node tools/build-extension-env.cjs",
    "build:extensions": "npm run build:extension-env && npm run build:parser-bundle",
    "lint": "npx eslint '**/*.{js,ts,cjs,mjs}'",
    "security:scan": "node tools/enhanced-security-scan.cjs",
    "security:scan-trufflehog": "trufflehog git file://. --since-commit HEAD~4 --only-verified --fail --no-update >/dev/null 2>&1 || (echo '🚨 Security scan failed - secrets detected!' && exit 1)",
    "security:scan-all": "trufflehog git file://. --only-verified --fail",
    "security:clean": "echo '🚨 SECURITY VIOLATION DETECTED! Remove all PII/secrets before committing.' && exit 1",
    "docs:review": "node scripts/review-claude-md.js",
    "docs:organize": "node scripts/organize-docs.cjs",
    "docs:check-links": "find . -name '*.md' -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/Pods/*' -not -path '*/build/*' -not -path '*/.validation-logs/*' -print0 | xargs -0 -n1 markdown-link-check -q -c .markdown-link-check.json",
    "quality:gate": "node scripts/mcp-diagnostics-gate.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.3",
    "@babel/traverse": "^7.28.3",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@types/chrome": "^0.1.38",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "dotenv": "^17.2.2",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^26.1.0",
    "markdown-link-check": "^3.14.2",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.54.0"
  },
  "author": "Matt Bordenet",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.980.0",
    "aws-cdk": "^2.1026.0",
    "aws-cdk-lib": "^2.212.0",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bordenet/RecipeArchive.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/bordenet/RecipeArchive/issues"
  },
  "homepage": "https://github.com/bordenet/RecipeArchive#readme",
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  }
}
