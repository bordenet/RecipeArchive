{
  "name": "@recipearchive/multi-tenant-tests",
  "version": "1.0.0",
  "description": "Multi-tenant invitation flow integration tests",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@jest/globals": "^29.7.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.11"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "verbose": true
  }
}
